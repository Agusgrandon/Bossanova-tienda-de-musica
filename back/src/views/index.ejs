<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>
    <main class="container">
        <h1>Productos</h1>

        <h2>Discos</h2>
        <section class="row g-4">
            <% discos.forEach(producto => { %>
                <%- include("partials/cards.ejs", { producto }) %>
            <% }) %>
        </section>

        <h2 class="mt-5">Hardware</h2>
        <section class="row g-4">
            <% hardware.forEach(producto => { %>
                <%- include("partials/cards.ejs", { producto }) %>
            <% }) %>
        </section>
    </main>
<%- include("partials/footer.ejs") %>