<%- include("partials/head.ejs") %>

<body>
    <header class="header">
        <div class="container">
            <a class="header-logo" href="/login">
                <img class="solo-claro" src="/assets/logo/logo-claro.svg" alt="Bossanova" width="206" height="40">
                <img class="solo-oscuro" src="/assets/logo/logo-oscuro.svg" alt="Bossanova" width="206" height="40">
            </a>

            <div class="header-acciones">
                <button class="boton boton-secundario" type="button" id="boton-tema" aria-label="Cambiar tema"
                    title="Cambiar tema">
                    <img class="solo-claro" src="/assets/iconos/luna.svg" alt="" width="20" height="20">
                    <img class="solo-oscuro" src="/assets/iconos/sol.svg" alt="" width="20" height="20">
                </button>
            </div>
        </div>
    </header>

<main class="container bienvenida">
    <h1>Login</h1>
    <form method="POST" class="formulario" action="/login">
        
        <label for="emailUser">Email</label>
        <input type="email" name="email" id="emailUser" >

        <label for="passwordUser">Password</label>
        <input type="password" name="password" id="passwordUser">

        <button type="submit" class="boton">Login</button>
    </form>

    <% if (typeof error !== "undefined") { %>
        <p class="mensaje error"> <%= error %> </p>
    <% } %>
</main>

<%- include("partials/footer.ejs") %>